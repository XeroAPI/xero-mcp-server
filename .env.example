# Xero API Configuration for Custom Connections
XERO_CLIENT_ID=your_client_id_here
XERO_CLIENT_SECRET=your_client_secret_here

# Alternatively, authenticate with a bearer token instead of a custom connection.
# XERO_CLIENT_BEARER_TOKEN=your_bearer_token_here

# Required when the credential can access more than one Xero organisation.
# Set this to a tenantId returned by Xero's /connections endpoint.
# XERO_TENANT_ID=your_tenant_id_here
