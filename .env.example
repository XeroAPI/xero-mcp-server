# Optional: keep these for the original local stdio / Custom Connection mode.
# The hosted ChatGPT connector uses the bearer token supplied by ChatGPT's Xero OAuth flow.
XERO_CLIENT_ID=your_client_id_here
XERO_CLIENT_SECRET=your_client_secret_here

# Optional for local stdio mode when using a long-lived bearer token.
XERO_CLIENT_BEARER_TOKEN=your_bearer_token_here

# Optional for local Custom Connection mode. Use the scopes supported by the
# Xero app. The hosted ChatGPT connector advertises src/xero-oauth-scopes.ts.
XERO_SCOPES=accounting.invoices accounting.payments accounting.banktransactions accounting.manualjournals accounting.contacts accounting.settings accounting.attachments accounting.journals.read accounting.reports.aged.read accounting.reports.balancesheet.read accounting.reports.profitandloss.read accounting.reports.trialbalance.read finance.statements.read finance.accountingactivity.read
